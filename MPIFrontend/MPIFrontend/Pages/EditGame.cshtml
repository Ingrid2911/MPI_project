@page "{id}"
@model MPIFrontend.Pages.EditGameModel

<a class="btn-green" asp-page="/Details" asp-route-id="@Model.Game.Id">← Back</a>

<h1 style="margin-top: 1.5rem;">Edit Game</h1>

<div class="game-capsule" style="flex-direction: column; align-items: stretch; gap: 1rem; margin-top: 1rem;">
    <form method="post">
        <div class="form-group">
            <label>Title</label>
            <input class="form-input" asp-for="Game.Title" placeholder="e.g. Elden Ring" />
            <span asp-validation-for="Game.Title" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Year</label>
            <input class="form-input" asp-for="Game.Year" type="number" placeholder="e.g. 2022" />
            <span asp-validation-for="Game.Year" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Genre</label>
            <input class="form-input" asp-for="Game.Genre" placeholder="e.g. RPG" />
            <span asp-validation-for="Game.Genre" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Rating</label>
            <input class="form-input" asp-for="Game.Rating" type="number" step="0.1" placeholder="e.g. 9.5" />
            <span asp-validation-for="Game.Rating" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea class="form-input" asp-for="Game.Description" rows="3" placeholder="Short description..."></textarea>
            <span asp-validation-for="Game.Description" class="form-error"></span>
        </div>
        <button type="submit" class="btn-green-filled" style="margin-top: 0.5rem;">Save Changes</button>
    </form>
</div>