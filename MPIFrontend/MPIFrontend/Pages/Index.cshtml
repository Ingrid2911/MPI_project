@page
@model IndexModel

<h1>Games</h1>

<table>
    <tr>
        <th>Title</th>
        <th>Year</th>
        <th>Genre</th>
        <th>Rating</th>
        <th>Description</th>
    </tr>
    @foreach (var game in Model.Games)
    {
        <tr>
            <td>@game.Title</td>
            <td>@game.Year</td>
            <td>@game.Genre</td>
            <td>@game.Rating</td>
            <td>@game.Description</td>
        </tr>
    }
</table>